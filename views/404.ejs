<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>404 · OBITO API</title>
<meta property="og:description" content="Melhor Base de API do momento">
<meta property="og:image" content="https://raw.githubusercontent.com/uploader762/dat3/main/uploads/3fae03-1776528467067.jpg">
<meta property="og:type" content="website">
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,700;14..32,800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
--bg: #080b12;
--surface: rgba(255,255,255,.04);
--border: rgba(255,255,255,.07);
--accent: #8b5cf6;
--accent2: #6d28d9;
--text: #f1f5f9;
--text-muted: #64748b;
}

body {
font-family: 'Inter', sans-serif;
background: var(--bg);
color: var(--text);
width: 100vw;
height: 100dvh;
display: flex;
align-items: center;
justify-content: center;
overflow: hidden;
position: fixed;
top: 0; left: 0;
}

body::before {
content: '';
position: fixed;
inset: 0;
background:
radial-gradient(ellipse 55% 55% at 50% 50%, rgba(139,92,246,.13) 0%, transparent 65%),
radial-gradient(ellipse 35% 35% at 15% 85%, rgba(99,102,241,.09) 0%, transparent 55%),
radial-gradient(ellipse 30% 30% at 85% 15%, rgba(139,92,246,.07) 0%, transparent 55%);
pointer-events: none;
}

.grid-bg {
position: fixed;
inset: 0;
background-image:
linear-gradient(rgba(139,92,246,.04) 1px, transparent 1px),
linear-gradient(90deg, rgba(139,92,246,.04) 1px, transparent 1px);
background-size: 48px 48px;
pointer-events: none;
mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 80%);
-webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 80%);
}

.wrap {
text-align: center;
position: relative;
z-index: 1;
padding: 24px 20px;
display: flex;
flex-direction: column;
align-items: center;
}

.num-wrap {
display: flex;
align-items: center;
justify-content: center;
line-height: 1;
margin-bottom: 2px;
position: relative;
}

.digit {
font-size: clamp(110px, 28vw, 200px);
font-weight: 800;
letter-spacing: -8px;
background: linear-gradient(160deg, #c4b5fd 0%, var(--accent) 45%, var(--accent2) 100%);
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
background-clip: text;
filter: drop-shadow(0 0 50px rgba(139,92,246,.4));
animation: floatDigit 5s ease-in-out infinite;
position: relative;
}
.digit:nth-child(1) { animation-delay: 0s; transform-origin: bottom center; }
.digit:nth-child(2) { animation-delay: .25s; }
.digit:nth-child(3) { animation-delay: .5s; transform-origin: bottom center; }

@keyframes floatDigit {
0%, 100% { transform: translateY(0px) rotate(0deg); }
30% { transform: translateY(-12px) rotate(-1.2deg); }
70% { transform: translateY(5px) rotate(.8deg); }
}

.zero-inner {
position: relative;
display: inline-block;
}

.face {
position: absolute;
top: 50%; left: 50%;
transform: translate(-50%, -46%);
display: flex;
flex-direction: column;
align-items: center;
gap: clamp(5px, 1.4vw, 10px);
pointer-events: none;
}

.eyes {
display: flex;
gap: clamp(10px, 2.8vw, 20px);
}

.eye {
width: clamp(8px, 2.2vw, 14px);
height: clamp(8px, 2.2vw, 14px);
border-radius: 50%;
background: #fff;
box-shadow: 0 0 12px rgba(255,255,255,.5);
position: relative;
animation: blink 5s ease-in-out infinite;
}
.eye.right { animation-delay: .06s; }

.eye::after {
content: '';
position: absolute;
width: 45%;
height: 45%;
border-radius: 50%;
background: var(--accent2);
top: 20%; left: 55%;
animation: look 6s ease-in-out infinite;
}

@keyframes look {
0%, 40%, 100% { transform: translate(0, 0); }
50% { transform: translate(-2px, 1px); }
60% { transform: translate(1px, -1px); }
70% { transform: translate(0, 2px); }
}

@keyframes blink {
0%, 42%, 52%, 100% { transform: scaleY(1); }
47% { transform: scaleY(.06); }
}

.mouth {
width: clamp(12px, 3.2vw, 22px);
height: clamp(6px, 1.6vw, 11px);
border-radius: 0 0 clamp(6px,1.6vw,11px) clamp(6px,1.6vw,11px);
background: rgba(255,255,255,.85);
box-shadow: 0 0 8px rgba(255,255,255,.3);
animation: mouthWobble 5s ease-in-out infinite;
transform-origin: center;
}

@keyframes mouthWobble {
0%, 100% { transform: scaleX(1); border-radius: 0 0 11px 11px; }
15% { transform: scaleX(.5) rotate(-4deg); border-radius: 4px; }
35% { transform: scaleX(1.2) rotate(2deg); border-radius: 0 0 11px 11px; }
55% { transform: scaleX(.8); }
75% { transform: scaleX(1.1) rotate(-1deg); }
}

.sweat {
position: absolute;
top: clamp(16px, 4.5vw, 30px);
right: clamp(0px, .5vw, 4px);
width: clamp(5px, 1.4vw, 9px);
height: clamp(9px, 2.8vw, 17px);
background: linear-gradient(to bottom, #93c5fd, #3b82f6);
border-radius: 50% 0 50% 50%;
transform: rotate(20deg);
box-shadow: 0 0 10px rgba(59,130,246,.5);
animation: sweatDrop 3s ease-in-out infinite;
}

@keyframes sweatDrop {
0% { opacity: 0; transform: rotate(20deg) translateY(-4px); }
10% { opacity: 1; }
75% { opacity: .8; transform: rotate(20deg) translateY(clamp(14px,4vw,26px)); }
76%, 100% { opacity: 0; transform: rotate(20deg) translateY(-4px); }
}

.reflection {
position: absolute;
bottom: -20px;
left: 50%;
transform: translateX(-50%);
width: 80%;
height: 30px;
background: linear-gradient(to bottom, rgba(139,92,246,.18), transparent);
filter: blur(8px);
border-radius: 50%;
animation: reflectionPulse 5s ease-in-out infinite;
}

@keyframes reflectionPulse {
0%, 100% { opacity: .6; transform: translateX(-50%) scaleX(1); }
50% { opacity: 1; transform: translateX(-50%) scaleX(1.1); }
}

.sub-label {
font-size: clamp(10px, 2.5vw, 12px);
font-weight: 700;
letter-spacing: 4px;
text-transform: uppercase;
color: var(--text-muted);
margin-top: 8px;
margin-bottom: 6px;
}

.msg {
font-size: clamp(14px, 3.5vw, 16px);
color: var(--text-muted);
margin-bottom: 32px;
}

.btn-back {
display: inline-flex;
align-items: center;
gap: 8px;
padding: 13px 26px;
background: linear-gradient(135deg, var(--accent), var(--accent2));
border: none;
border-radius: 14px;
color: #fff;
font-family: 'Inter', sans-serif;
font-size: 14px;
font-weight: 700;
text-decoration: none;
transition: all .25s;
box-shadow: 0 4px 28px rgba(139,92,246,.35);
position: relative;
overflow: hidden;
}
.btn-back::before {
content: '';
position: absolute;
inset: 0;
background: linear-gradient(135deg, rgba(255,255,255,.12), transparent);
opacity: 0;
transition: opacity .25s;
}
.btn-back:hover { transform: translateY(-2px); box-shadow: 0 8px 36px rgba(139,92,246,.55); }
.btn-back:hover::before { opacity: 1; }
.btn-back:active { transform: scale(.97); }

.particles {
position: fixed;
inset: 0;
pointer-events: none;
overflow: hidden;
}
.p {
position: absolute;
border-radius: 50%;
background: var(--accent);
opacity: 0;
animation: drift linear infinite;
}
@keyframes drift {
0% { opacity: 0; transform: translateY(100vh) scale(0) rotate(0deg); }
8% { opacity: .5; }
92% { opacity: .1; }
100% { opacity: 0; transform: translateY(-8vh) scale(1.2) rotate(180deg); }
}

.scanline {
position: fixed;
inset: 0;
background: repeating-linear-gradient(
0deg,
transparent,
transparent 3px,
rgba(0,0,0,.03) 3px,
rgba(0,0,0,.03) 4px
);
pointer-events: none;
z-index: 0;
}
</style>
</head>
<body>

<div class="scanline"></div>
<div class="grid-bg"></div>
<div class="particles" id="particles"></div>

<div class="wrap">
<div class="num-wrap">
<span class="digit">4</span>
<span class="digit">
<span class="zero-inner">
0
<div class="face">
<div class="eyes">
<div class="eye left"></div>
<div class="eye right"></div>
</div>
<div class="mouth"></div>
</div>
<div class="sweat"></div>
</span>
<div class="reflection"></div>
</span>
<span class="digit">4</span>
</div>
<div class="sub-label">page not found</div>
<div class="msg">a página que você procura não existe</div>
<a href="/dash" class="btn-back"><i class="bi bi-arrow-left"></i> voltar ao início</a>
</div>

<script>
var p = document.getElementById('particles');
for (var i = 0; i < 24; i++) {
var el = document.createElement('div');
el.className = 'p';
var size = Math.random() * 3 + 1.5;
el.style.cssText = [
'width:' + size + 'px',
'height:' + size + 'px',
'left:' + Math.random() * 100 + '%',
'animation-duration:' + (Math.random() * 14 + 10) + 's',
'animation-delay:' + (Math.random() * 12) + 's'
].join(';');
p.appendChild(el);
}
</script>
</body>
</html>