<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title><%= title || 'Editar Perfil · OBITO API' %></title>
<meta property="og:description" content="Melhor Base de API do momento">
<meta property="og:image" content="https://raw.githubusercontent.com/uploader762/dat3/main/uploads/3fae03-1776528467067.jpg">
<meta property="og:type" content="website">
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
--bg: #080b12;
--bg2: #0d1120;
--surface: rgba(255,255,255,.04);
--surface-hover: rgba(255,255,255,.07);
--border: rgba(255,255,255,.07);
--accent: #8b5cf6;
--accent2: #6d28d9;
--accent-glow: rgba(139,92,246,.15);
--text: #f1f5f9;
--text-muted: #64748b;
--text-dim: #334155;
--success: #34d399;
--error: #f87171;
}

body {
font-family: 'Inter', sans-serif;
background: var(--bg);
color: var(--text);
width: 100vw;
height: 100dvh;
overflow: hidden;
display: flex;
flex-direction: column;
position: fixed;
top: 0; left: 0;
}

body::before {
content: '';
position: fixed;
inset: 0;
background:
radial-gradient(ellipse 70% 50% at 80% -10%, rgba(139,92,246,.18) 0%, transparent 55%),
radial-gradient(ellipse 50% 40% at -10% 90%, rgba(99,102,241,.12) 0%, transparent 55%);
pointer-events: none;
z-index: 0;
}

header {
display: flex;
align-items: center;
justify-content: space-between;
padding: 14px 20px;
border-bottom: 1px solid var(--border);
background: rgba(8,11,18,.8);
backdrop-filter: blur(20px);
-webkit-backdrop-filter: blur(20px);
flex-shrink: 0;
z-index: 50;
position: relative;
}

.back-btn {
width: 36px; height: 36px;
border-radius: 10px;
background: var(--surface);
border: 1px solid var(--border);
display: flex;
align-items: center;
justify-content: center;
color: var(--text-muted);
font-size: 16px;
text-decoration: none;
transition: all .2s;
}
.back-btn:hover { color: var(--text); border-color: rgba(139,92,246,.4); background: rgba(139,92,246,.08); }

.hdr-title {
font-size: 14px;
font-weight: 700;
letter-spacing: 1.5px;
text-transform: uppercase;
color: var(--text-muted);
}

.hdr-spacer { width: 36px; }

.page {
flex: 1;
overflow-y: auto;
overflow-x: hidden;
scrollbar-width: none;
-webkit-overflow-scrolling: touch;
position: relative;
z-index: 1;
}
.page::-webkit-scrollbar { display: none; }

.inner {
max-width: 460px;
margin: 0 auto;
padding: 20px 16px 100px;
display: flex;
flex-direction: column;
gap: 14px;
}

.preview-card {
background: var(--surface);
border: 1px solid var(--border);
border-radius: 20px;
overflow: hidden;
animation: cardRise .5s cubic-bezier(.22,1,.36,1) both;
}
@keyframes cardRise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

.preview-banner {
height: 64px;
background-size: cover;
background-position: center;
background-color: var(--bg2);
position: relative;
transition: background-image .3s;
}
.preview-banner.no-capa {
background-image:
repeating-linear-gradient(0deg, transparent, transparent 24px, rgba(139,92,246,.05) 24px, rgba(139,92,246,.05) 25px),
repeating-linear-gradient(90deg, transparent, transparent 24px, rgba(139,92,246,.05) 24px, rgba(139,92,246,.05) 25px);
}
.preview-banner::after {
content: '';
position: absolute;
inset: 0;
background: linear-gradient(to bottom, transparent 20%, rgba(8,11,18,.8));
}

.preview-body {
padding: 0 16px 16px;
display: flex;
align-items: flex-end;
gap: 12px;
}

.preview-av-wrap { margin-top: -22px; position: relative; z-index: 2; flex-shrink: 0; }
.preview-av-ring {
width: 52px; height: 52px;
border-radius: 14px;
padding: 2px;
background: linear-gradient(135deg, var(--accent), rgba(99,102,241,.6));
box-shadow: 0 0 18px rgba(139,92,246,.3);
transition: all .3s;
}
.preview-av {
width: 100%; height: 100%;
border-radius: 12px;
background-size: cover;
background-position: center;
}

.preview-info { padding-top: 8px; }
.preview-name {
font-size: 15px;
font-weight: 700;
}
.preview-sub {
font-size: 11px;
color: var(--text-muted);
margin-top: 2px;
font-family: 'Space Mono', monospace;
}

.fields {
display: flex;
flex-direction: column;
gap: 10px;
animation: cardRise .5s .1s cubic-bezier(.22,1,.36,1) both;
}

.field { display: flex; flex-direction: column; gap: 6px; }

.field-label {
font-size: 10px;
font-weight: 700;
color: var(--text-muted);
letter-spacing: 1px;
text-transform: uppercase;
display: flex;
align-items: center;
gap: 6px;
}
.field-label i { font-size: 12px; color: var(--accent); opacity: .7; }

input {
font-family: 'Inter', sans-serif;
width: 100%;
padding: 13px 16px;
background: rgba(255,255,255,.04);
border: 1px solid var(--border);
border-radius: 12px;
color: var(--text);
font-size: 14px;
outline: none;
transition: border-color .2s, box-shadow .2s, background .2s;
}
input:focus {
border-color: var(--accent);
box-shadow: 0 0 0 3px var(--accent-glow);
background: rgba(139,92,246,.04);
}
input::placeholder { color: var(--text-dim); }

.field-key input {
font-family: 'Space Mono', monospace;
font-size: 12px;
letter-spacing: .5px;
color: var(--accent);
background: rgba(139,92,246,.05);
border-color: rgba(139,92,246,.2);
}
.field-key input:focus { border-color: var(--accent); }

.save-wrap {
animation: cardRise .5s .2s cubic-bezier(.22,1,.36,1) both;
}

.btn-save {
display: flex;
align-items: center;
justify-content: center;
gap: 9px;
width: 100%;
padding: 15px 20px;
background: linear-gradient(135deg, var(--accent), var(--accent2));
border: none;
border-radius: 16px;
color: #fff;
font-family: 'Inter', sans-serif;
font-size: 14px;
font-weight: 700;
letter-spacing: .3px;
cursor: pointer;
transition: all .25s;
box-shadow: 0 0 0 rgba(139,92,246,0);
}
.btn-save:hover { box-shadow: 0 4px 24px rgba(139,92,246,.4); transform: translateY(-1px); }
.btn-save:active { transform: scale(.98); }
.btn-save:disabled { opacity: .6; cursor: not-allowed; transform: none; box-shadow: none; }

.toast {
position: fixed;
top: 20px;
left: 50%;
transform: translateX(-50%) translateY(-80px);
background: var(--bg2);
border: 1px solid var(--border);
border-radius: 100px;
padding: 11px 22px;
display: flex;
align-items: center;
gap: 9px;
font-size: 13px;
font-weight: 500;
z-index: 1000;
transition: transform .35s cubic-bezier(.34,1.56,.64,1);
backdrop-filter: blur(16px);
white-space: nowrap;
box-shadow: 0 8px 32px rgba(0,0,0,.5);
}
.toast.show { transform: translateX(-50%) translateY(0); }
.toast.success { border-color: rgba(52,211,153,.3); color: var(--success); }
.toast.error { border-color: rgba(248,113,113,.3); color: var(--error); }

@media (max-width: 360px) {
.inner { padding: 16px 12px 90px; gap: 12px; }
}
@media (min-width: 640px) {
.inner { padding: 28px 20px 80px; }
}
</style>
</head>
<body>

<div class="toast" id="toast"></div>

<header>
<a href="/perfil" class="back-btn"><i class="bi bi-arrow-left"></i></a>
<span class="hdr-title">editar perfil</span>
<div class="hdr-spacer"></div>
</header>

<div class="page">
<div class="inner">

<div class="preview-card">
<div class="preview-banner <%= user.capa ? '' : 'no-capa' %>" id="previewBanner"<% if (user.capa) { %> style="background-image:url('<%= user.capa %>');"<% } %>></div>
<div class="preview-body">
<div class="preview-av-wrap">
<div class="preview-av-ring">
<div class="preview-av" id="previewAv" style="background-image:url('<%= user.foto %>');"></div>
</div>
</div>
<div class="preview-info">
<div class="preview-name" id="previewName"><%= user.username %></div>
<div class="preview-sub">pré-visualização</div>
</div>
</div>
</div>

<div class="fields">
<div class="field">
<span class="field-label"><i class="bi bi-person"></i> nome de usuário</span>
<input type="text" id="username" value="<%= user.username %>" maxlength="20" placeholder="seu usuário">
</div>
<div class="field">
<span class="field-label"><i class="bi bi-image"></i> url da foto</span>
<input type="url" id="foto" value="<%= user.foto %>" placeholder="https://...">
</div>
<div class="field">
<span class="field-label"><i class="bi bi-card-image"></i> url da capa</span>
<input type="url" id="capa" value="<%= user.capa || '' %>" placeholder="https://...">
</div>
<% if (user.premium || user.adm) { %>
<div class="field field-key">
<span class="field-label"><i class="bi bi-key"></i> chave de api</span>
<input type="text" id="key" value="<%= user.key %>">
</div>
<% } %>
</div>

<div class="save-wrap">
<button class="btn-save" id="saveBtn">
<i class="bi bi-check-lg"></i> salvar alterações
</button>
</div>

</div>
</div>

<script>
function showToast(msg, tipo) {
var t = document.getElementById('toast');
t.className = 'toast ' + tipo + ' show';
t.innerHTML = '<i class="bi bi-' + (tipo === 'success' ? 'check-circle' : 'x-circle') + '"></i> ' + msg;
clearTimeout(t._t);
t._t = setTimeout(function() { t.classList.remove('show'); }, 2500);
}

document.getElementById('username').addEventListener('input', function() {
document.getElementById('previewName').textContent = this.value || '<%= user.username %>';
});

document.getElementById('foto').addEventListener('input', function() {
if (this.value) document.getElementById('previewAv').style.backgroundImage = "url('" + this.value + "')";
});

document.getElementById('capa').addEventListener('input', function() {
var banner = document.getElementById('previewBanner');
if (this.value) {
banner.style.backgroundImage = "url('" + this.value + "')";
banner.classList.remove('no-capa');
} else {
banner.style.backgroundImage = '';
banner.classList.add('no-capa');
}
});

document.getElementById('saveBtn').addEventListener('click', async function() {
var btn = this;
btn.disabled = true;
btn.innerHTML = '<i class="bi bi-hourglass-split"></i> salvando...';

var payload = {
username: document.getElementById('username').value.trim(),
foto: document.getElementById('foto').value.trim(),
capa: document.getElementById('capa').value.trim()
};
var keyField = document.getElementById('key');
if (keyField) payload.key = keyField.value.trim();

try {
var r = await fetch('/api/perfil/editar', {
method: 'POST',
headers: { 'Content-Type': 'application/json' },
body: JSON.stringify(payload)
});
var d = await r.json();
if (d.success) {
showToast('perfil atualizado!', 'success');
setTimeout(function() { window.location.href = '/perfil'; }, 1000);
} else {
showToast(d.message || 'erro ao salvar', 'error');
btn.disabled = false;
btn.innerHTML = '<i class="bi bi-check-lg"></i> salvar alterações';
}
} catch(e) {
showToast('erro de conexão', 'error');
btn.disabled = false;
btn.innerHTML = '<i class="bi bi-check-lg"></i> salvar alterações';
}
});
</script>
</body>
</html>
