<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title><%= title || 'Perfil · OBITO API' %></title>
<meta property="og:description" content="Melhor Base de API do momento">
<meta property="og:image" content="https://raw.githubusercontent.com/uploader762/dat3/main/uploads/3fae03-1776528467067.jpg">
<meta property="og:type" content="website">
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
--bg: #080b12;
--bg2: #0d1120;
--surface: rgba(255,255,255,.04);
--surface-hover: rgba(255,255,255,.07);
--border: rgba(255,255,255,.07);
--accent: #8b5cf6;
--accent2: #6d28d9;
--accent-glow: rgba(139,92,246,.15);
--text: #f1f5f9;
--text-muted: #64748b;
--text-dim: #334155;
--success: #34d399;
--error: #f87171;
}

body {
font-family: 'Inter', sans-serif;
background: var(--bg);
color: var(--text);
width: 100vw;
height: 100dvh;
overflow: hidden;
display: flex;
flex-direction: column;
position: fixed;
top: 0; left: 0;
}

body::before {
content: '';
position: fixed;
inset: 0;
background:
radial-gradient(ellipse 70% 50% at 80% -10%, rgba(139,92,246,.18) 0%, transparent 55%),
radial-gradient(ellipse 50% 40% at -10% 90%, rgba(99,102,241,.12) 0%, transparent 55%);
pointer-events: none;
z-index: 0;
}

header {
display: flex;
align-items: center;
justify-content: space-between;
padding: 14px 20px;
border-bottom: 1px solid var(--border);
background: rgba(8,11,18,.8);
backdrop-filter: blur(20px);
-webkit-backdrop-filter: blur(20px);
flex-shrink: 0;
z-index: 50;
position: relative;
}

.back-btn {
width: 36px; height: 36px;
border-radius: 10px;
background: var(--surface);
border: 1px solid var(--border);
display: flex;
align-items: center;
justify-content: center;
color: var(--text-muted);
font-size: 16px;
text-decoration: none;
transition: all .2s;
}
.back-btn:hover { color: var(--text); border-color: rgba(139,92,246,.4); background: rgba(139,92,246,.08); }

.hdr-title {
font-size: 14px;
font-weight: 700;
letter-spacing: 1.5px;
text-transform: uppercase;
color: var(--text-muted);
}

.hdr-edit-btn {
width: 36px; height: 36px;
border-radius: 10px;
background: rgba(139,92,246,.1);
border: 1px solid rgba(139,92,246,.25);
display: flex;
align-items: center;
justify-content: center;
color: var(--accent);
font-size: 16px;
text-decoration: none;
transition: all .2s;
}
.hdr-edit-btn:hover { background: rgba(139,92,246,.2); box-shadow: 0 0 16px rgba(139,92,246,.25); }

.page {
flex: 1;
overflow-y: auto;
overflow-x: hidden;
scrollbar-width: none;
-webkit-overflow-scrolling: touch;
position: relative;
z-index: 1;
}
.page::-webkit-scrollbar { display: none; }

.inner {
max-width: 460px;
margin: 0 auto;
padding: 20px 16px 100px;
display: flex;
flex-direction: column;
gap: 14px;
}

.flash {
padding: 12px 16px;
border-radius: 12px;
font-size: 13px;
font-weight: 500;
display: flex;
align-items: center;
gap: 8px;
animation: fadeSlideDown .3s ease;
}
.flash-success { background: rgba(52,211,153,.07); border: 1px solid rgba(52,211,153,.2); color: var(--success); }
.flash-error { background: rgba(248,113,113,.07); border: 1px solid rgba(248,113,113,.2); color: var(--error); }
@keyframes fadeSlideDown { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }

.hero-card {
border-radius: 24px;
overflow: hidden;
border: 1px solid var(--border);
background: var(--surface);
animation: cardRise .5s cubic-bezier(.22,1,.36,1) both;
}
@keyframes cardRise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

.hero-banner {
height: clamp(72px,20vw,108px);
background-size: cover;
background-position: center;
background-color: var(--bg2);
position: relative;
}
.hero-banner::after {
content: '';
position: absolute;
inset: 0;
background: linear-gradient(to bottom, rgba(8,11,18,0) 20%, rgba(8,11,18,.85));
}
.hero-banner.no-capa {
background-image:
repeating-linear-gradient(0deg, transparent, transparent 24px, rgba(139,92,246,.05) 24px, rgba(139,92,246,.05) 25px),
repeating-linear-gradient(90deg, transparent, transparent 24px, rgba(139,92,246,.05) 24px, rgba(139,92,246,.05) 25px);
}

.hero-body {
padding: 0 20px 22px;
display: flex;
flex-direction: column;
align-items: center;
text-align: center;
}

.avatar-wrap {
margin-top: clamp(-30px,-8vw,-38px);
margin-bottom: 12px;
position: relative;
z-index: 2;
}
.avatar-ring {
width: clamp(64px,17vw,80px);
height: clamp(64px,17vw,80px);
border-radius: 20px;
padding: 3px;
background: linear-gradient(135deg, var(--accent), rgba(99,102,241,.6));
box-shadow: 0 0 28px rgba(139,92,246,.35), 0 8px 24px rgba(0,0,0,.5);
animation: avatarGlow 3s ease-in-out infinite;
}
@keyframes avatarGlow {
0%,100% { box-shadow: 0 0 28px rgba(139,92,246,.35), 0 8px 24px rgba(0,0,0,.5); }
50% { box-shadow: 0 0 44px rgba(139,92,246,.6), 0 8px 24px rgba(0,0,0,.5); }
}
.avatar-img {
width: 100%; height: 100%;
border-radius: 17px;
background-size: cover;
background-position: center;
}
.avatar-online {
position: absolute;
bottom: 3px; right: 3px;
width: 12px; height: 12px;
border-radius: 50%;
background: #34d399;
border: 2px solid var(--bg);
box-shadow: 0 0 8px rgba(52,211,153,.6);
}

.hero-username {
font-size: clamp(18px,6vw,22px);
font-weight: 800;
letter-spacing: -.2px;
display: flex;
align-items: center;
gap: 6px;
flex-wrap: wrap;
justify-content: center;
}
.hero-username .verified { color: var(--accent); font-size: 14px; filter: drop-shadow(0 0 6px var(--accent)); }
.hero-username .premium-ic { color: #fbbf24; font-size: 14px; filter: drop-shadow(0 0 6px rgba(251,191,36,.6)); }

.hero-badges {
display: flex;
gap: 6px;
margin-top: 8px;
flex-wrap: wrap;
justify-content: center;
}

.level-badge {
display: inline-flex;
align-items: center;
gap: 5px;
background: rgba(139,92,246,.1);
border: 1px solid rgba(139,92,246,.25);
border-radius: 100px;
padding: 4px 12px;
font-size: 11px;
font-weight: 700;
color: var(--accent);
letter-spacing: .5px;
}

.badge-pill {
display: inline-flex;
align-items: center;
gap: 4px;
padding: 3px 10px;
border-radius: 100px;
font-size: 10px;
font-weight: 600;
letter-spacing: .3px;
}
.badge-admin { background: rgba(139,92,246,.15); color: var(--accent); border: 1px solid rgba(139,92,246,.3); }
.badge-premium { background: rgba(251,191,36,.1); color: #fbbf24; border: 1px solid rgba(251,191,36,.25); }

.xp-section {
width: 100%;
margin-top: 16px;
display: flex;
flex-direction: column;
gap: 6px;
}
.xp-row {
display: flex;
justify-content: space-between;
align-items: center;
}
.xp-label { font-size: 10px; font-weight: 700; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; }
.xp-nums { font-family: 'Space Mono', monospace; font-size: 10px; color: var(--accent); }
.xp-track {
height: 5px;
border-radius: 100px;
background: rgba(139,92,246,.12);
overflow: hidden;
}
.xp-fill {
height: 100%;
border-radius: 100px;
background: linear-gradient(90deg, #6d28d9, #8b5cf6, #a78bfa);
box-shadow: 0 0 8px rgba(139,92,246,.5);
transition: width .9s cubic-bezier(.34,1.56,.64,1);
}

.stat-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 10px;
animation: cardRise .5s .1s cubic-bezier(.22,1,.36,1) both;
}
.stat-card {
background: var(--surface);
border: 1px solid var(--border);
border-radius: 18px;
padding: 16px;
display: flex;
flex-direction: column;
gap: 3px;
transition: border-color .2s, background .2s, transform .2s;
position: relative;
overflow: hidden;
}
.stat-card::before {
content: '';
position: absolute;
inset: 0;
border-radius: 18px;
background: radial-gradient(ellipse 60% 60% at 80% 20%, rgba(139,92,246,.06), transparent);
pointer-events: none;
}
.stat-card:hover { background: var(--surface-hover); border-color: rgba(139,92,246,.3); transform: translateY(-2px); }
.stat-icon { font-size: 18px; opacity: .8; margin-bottom: 4px; }
.stat-lbl { font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .8px; font-weight: 700; }
.stat-val { font-size: clamp(20px,6vw,26px); font-weight: 800; line-height: 1; }

.stat-card.requests .stat-val,
.stat-card.requests .stat-icon { color: #34d399; }
.stat-card.xp .stat-val,
.stat-card.xp .stat-icon { color: #fbbf24; }

.key-section {
display: flex;
flex-direction: column;
gap: 8px;
animation: cardRise .5s .2s cubic-bezier(.22,1,.36,1) both;
}
.section-label {
font-size: 10px;
font-weight: 700;
color: var(--text-muted);
letter-spacing: 1.2px;
text-transform: uppercase;
display: flex;
align-items: center;
gap: 6px;
}
.section-label::after { content: ''; flex: 1; height: 1px; background: var(--border); }

.key-card {
background: rgba(139,92,246,.05);
border: 1px solid rgba(139,92,246,.18);
border-radius: 16px;
padding: 14px 16px;
display: flex;
align-items: center;
gap: 12px;
transition: border-color .2s, background .2s;
}
.key-card:hover { border-color: rgba(139,92,246,.35); background: rgba(139,92,246,.09); }

.key-icon { color: rgba(139,92,246,.55); font-size: 18px; flex-shrink: 0; }
.key-val {
font-family: 'Space Mono', monospace;
font-size: clamp(11px,3vw,13px);
color: var(--accent);
letter-spacing: .5px;
flex: 1;
overflow: hidden;
text-overflow: ellipsis;
white-space: nowrap;
}
.key-masked { letter-spacing: 2px; }

.key-actions { display: flex; gap: 6px; flex-shrink: 0; }
.key-btn {
width: 32px; height: 32px;
border-radius: 9px;
background: rgba(139,92,246,.1);
border: 1px solid rgba(139,92,246,.2);
display: flex;
align-items: center;
justify-content: center;
color: var(--accent);
font-size: 14px;
cursor: pointer;
transition: all .2s;
}
.key-btn:hover { background: rgba(139,92,246,.22); box-shadow: 0 0 12px rgba(139,92,246,.3); transform: scale(1.05); }
.key-btn:active { transform: scale(.95); }

.edit-btn-wrap { animation: cardRise .5s .3s cubic-bezier(.22,1,.36,1) both; }
.btn-edit-profile {
display: flex;
align-items: center;
justify-content: center;
gap: 9px;
width: 100%;
padding: 15px 20px;
background: linear-gradient(135deg, rgba(139,92,246,.15), rgba(99,102,241,.1));
border: 1px solid rgba(139,92,246,.3);
border-radius: 16px;
color: var(--text);
font-family: 'Inter', sans-serif;
font-size: 14px;
font-weight: 700;
letter-spacing: .5px;
text-decoration: none;
transition: all .25s;
position: relative;
overflow: hidden;
}
.btn-edit-profile:hover { border-color: rgba(139,92,246,.6); box-shadow: 0 0 24px rgba(139,92,246,.2); transform: translateY(-1px); }
.btn-edit-profile:active { transform: scale(.98); }
.btn-edit-profile i { font-size: 16px; color: var(--accent); }

.toast {
position: fixed;
top: 20px;
left: 50%;
transform: translateX(-50%) translateY(-80px);
background: var(--bg2);
border: 1px solid var(--border);
border-radius: 100px;
padding: 11px 22px;
display: flex;
align-items: center;
gap: 9px;
font-size: 13px;
font-weight: 500;
z-index: 1000;
transition: transform .35s cubic-bezier(.34,1.56,.64,1);
backdrop-filter: blur(16px);
white-space: nowrap;
box-shadow: 0 8px 32px rgba(0,0,0,.5);
}
.toast.show { transform: translateX(-50%) translateY(0); }
.toast.success { border-color: rgba(52,211,153,.3); color: var(--success); }
.toast.error { border-color: rgba(248,113,113,.3); color: var(--error); }

@media (max-width: 360px) {
.inner { padding: 16px 12px 90px; gap: 12px; }
.stat-val { font-size: 20px; }
}
@media (min-width: 640px) {
.inner { padding: 28px 20px 80px; }
}
</style>
</head>
<body>

<div class="toast" id="toast"></div>

<header>
<a href="/dash" class="back-btn"><i class="bi bi-arrow-left"></i></a>
<span class="hdr-title">perfil</span>
<a href="/perfil/editar" class="hdr-edit-btn"><i class="bi bi-pencil"></i></a>
</header>

<div class="page">
<div class="inner">

<% if (success_msg && success_msg.length) { %>
<div class="flash flash-success"><i class="bi bi-check-circle-fill"></i> <%= success_msg %></div>
<% } %>
<% if (error_msg && error_msg.length) { %>
<div class="flash flash-error"><i class="bi bi-x-circle-fill"></i> <%= error_msg %></div>
<% } %>

<div class="hero-card">
<div class="hero-banner <%= user.capa ? '' : 'no-capa' %>"<% if (user.capa) { %> style="background-image:url('<%= user.capa %>');"<% } %>></div>
<div class="hero-body">
<div class="avatar-wrap">
<div class="avatar-ring">
<div class="avatar-img" style="background-image:url('<%= user.foto %>');"></div>
</div>
<div class="avatar-online"></div>
</div>
<div class="hero-username">
<%= user.username %>
<% if (user.adm) { %><i class="bi bi-patch-check-fill verified"></i><% } %>
<% if (user.premium) { %><i class="bi bi-lightning-charge-fill premium-ic"></i><% } %>
</div>
<div class="hero-badges">
<div class="level-badge"><i class="bi bi-layers-fill"></i> LV <%= user.level || 1 %></div>
<% if (user.premium) { %><div class="badge-pill badge-premium"><i class="bi bi-lightning-charge-fill"></i> premium</div><% } %>
<% if (user.adm) { %><div class="badge-pill badge-admin"><i class="bi bi-shield-check"></i> admin</div><% } %>
</div>
<div class="xp-section">
<div class="xp-row">
<span class="xp-label">progresso</span>
<span class="xp-nums" id="xpNums">...</span>
</div>
<div class="xp-track">
<div class="xp-fill" id="xpFill" style="width:0%"></div>
</div>
</div>
</div>
</div>

<div class="stat-grid">
<div class="stat-card requests">
<i class="bi bi-activity stat-icon"></i>
<div class="stat-lbl">requests</div>
<div class="stat-val"><%= user.totalRequests || 0 %></div>
</div>
<div class="stat-card xp">
<i class="bi bi-trophy-fill stat-icon"></i>
<div class="stat-lbl">xp total</div>
<div class="stat-val"><%= user.xp || 0 %></div>
</div>
</div>

<div class="key-section">
<div class="section-label">chave de api</div>
<div class="key-card">
<i class="bi bi-key-fill key-icon"></i>
<span class="key-val key-masked" id="apiKey" data-key="<%= user.key %>">••••••••••••</span>
<div class="key-actions">
<div class="key-btn" id="toggleKey"><i class="bi bi-eye" id="eyeIcon"></i></div>
<div class="key-btn" id="copyKey"><i class="bi bi-copy" id="copyIcon"></i></div>
</div>
</div>
</div>

<div class="edit-btn-wrap">
<a href="/perfil/editar" class="btn-edit-profile">
<i class="bi bi-pencil-square"></i>
editar perfil
</a>
</div>

</div>
</div>

<script>
(function() {
var xp = <%= user.xp || 0 %>;
var level = <%= user.level || 1 %>;
var xpMax = level * 50;
var pct = Math.min(Math.round((xp / xpMax) * 100), 100);
document.getElementById('xpNums').textContent = xp + ' / ' + xpMax + ' xp';
requestAnimationFrame(function() {
requestAnimationFrame(function() {
document.getElementById('xpFill').style.width = pct + '%';
});
});
})();

var revealed = false;
var keyEl = document.getElementById('apiKey');
var eyeIcon = document.getElementById('eyeIcon');
var realKey = keyEl.dataset.key;

document.getElementById('toggleKey').addEventListener('click', function() {
revealed = !revealed;
if (revealed) {
keyEl.textContent = realKey;
keyEl.classList.remove('key-masked');
eyeIcon.className = 'bi bi-eye-slash';
} else {
keyEl.textContent = '••••••••••••';
keyEl.classList.add('key-masked');
eyeIcon.className = 'bi bi-eye';
}
});

document.getElementById('copyKey').addEventListener('click', function() {
navigator.clipboard.writeText(realKey).then(function() {
var ci = document.getElementById('copyIcon');
ci.className = 'bi bi-check2';
showToast('success', '<i class="bi bi-check-circle"></i> chave copiada!');
setTimeout(function() { ci.className = 'bi bi-copy'; }, 2000);
});
});

function showToast(type, html) {
var t = document.getElementById('toast');
t.className = 'toast ' + type + ' show';
t.innerHTML = html;
clearTimeout(t._t);
t._t = setTimeout(function() { t.classList.remove('show'); }, 2200);
}
</script>
</body>
</html>